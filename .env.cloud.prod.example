# Cloud production deployment test environment
# Used with: docker compose --env-file .env.cloud.prod -f docker-compose.cloud.prod.yml up -d --build

# Application
APP_NAME=muilti-domain-rag

# Nginx
NGINX_VERSION=1.30.4-alpine3.24
NGINX_BIND_ADDRESS=0.0.0.0
NGINX_PORT=8080
NGINX_PROD_CONFIG=./nginx/default.prod.conf

# Pre-built React artifact
# This directory must contain index.html and assets/ directly.
WEB_DIST_PATH=./dist

# Tomcat WAS
TOMCAT_VERSION=10.1.59-jre21-temurin-noble
TOMCAT_DOCKERFILE=tomcat/Dockerfile
TOMCAT_IMAGE=tomcat-frontend:${APP_NAME}

# Pre-built WAR artifact
# The WAR is mounted as /usr/local/tomcat/webapps/ROOT.war.
WAR_PATH=./war/frontend.war
