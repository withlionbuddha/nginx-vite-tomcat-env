# syntax=docker/dockerfile:1
FROM node:${NODE_VERSION:-24.20.0-bookworm} AS build

WORKDIR /workspace/react-web-ui

COPY --from=web_ui_source package.json package-lock.json ./
RUN npm ci

# Copy source without overwriting Linux dependencies with host node_modules.
RUN --mount=type=bind,from=web_ui_source,target=/source \
    tar -C /source --exclude=node_modules --exclude=dist --exclude=.git -cf /tmp/react-web-ui-source.tar . \
    && tar -C /workspace/react-web-ui -xf /tmp/react-web-ui-source.tar \
    && rm /tmp/react-web-ui-source.tar
RUN npm run build

FROM nginx:1.30.4-alpine3.24

ARG NGINX_CONFIG=default.env.dev.conf
ARG SSL_DIR_PATH=/etc/nginx/ssl

COPY --from=build /workspace/react-web-ui/dist/ /usr/share/nginx/html/

# ${NGINX_CONFIG} 
#COPY nginx/${NGINX_CONFIG} /etc/nginx/conf.d/default.conf

# ${NGINX_ENV_CONFIG} : nginx.env file 사용.
COPY nginx/${NGINX_CONFIG} /etc/nginx/templates/default.conf.template

RUN mkdir -p "${SSL_DIR_PATH}"

EXPOSE 80
