### nginx container 내부의 환경변수 ###

#server config
SERVER_NAME=localhost
TOMCAT_HOST=tomcat-frontend
TOMCAT_PORT=8080
SSL_DIR=/etc/nginx/ssl
SSL_CERT_PATH=/etc/nginx/ssl/nginx-cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/nginx-key.pem

NGINX_CONTAINER_PORT=80
NGINX_CONTAINER_SSL_PORT=443

#NGINX_ENVSUBST_FILTER=^(SERVER_NAME|TOMCAT_HOST|TOMCAT_PORT|SSL_CERT_PATH|SSL_KEY_PATH)$




