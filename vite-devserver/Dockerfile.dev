FROM node:24.20.0-bookworm

WORKDIR /workspace/web-ui

# React source is mounted by Compose at runtime, including package.json.
COPY scripts/init-web-ui.sh scripts/start-vite.sh /opt/dev/scripts/
# A Windows checkout may use CRLF even when scripts run with Linux sh.
RUN sed -i 's/\r$//' /opt/dev/scripts/*.sh

EXPOSE 8183

CMD ["sh", "/opt/dev/scripts/start-vite.sh"]
