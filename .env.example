APP_NAME=muilti-domain-rag
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8080

# Main React source directory on the host.
WEB_UI_HOST_PATH=../web-ui
# Windows example: WEB_UI_HOST_PATH=F:/project.rag/web-ui
# WSL example: WEB_UI_HOST_PATH=/mnt/f/project.rag/web-ui
# Linux example: WEB_UI_HOST_PATH=/srv/project.rag/web-ui
VITE_BIND_ADDRESS=127.0.0.1
VITE_PORT=8183

# Reference React source directory on the host.
# This variable is not required by docker-compose.dev.no-reference.yml.
REFERENCE_UI_HOST_PATH=../reactex/bulletproof-react
# Windows example: REFERENCE_UI_HOST_PATH=F:/project.rag/reactex/bulletproof-react
# WSL example: REFERENCE_UI_HOST_PATH=/mnt/f/project.rag/reactex/bulletproof-react
# Linux example: REFERENCE_UI_HOST_PATH=/srv/project.rag/reactex/bulletproof-react
REFERENCE_UI_BIND_ADDRESS=127.0.0.1
REFERENCE_UI_PORT=8184

# Enable file polling for edits to Windows files mounted into Linux containers.
VITE_USE_POLLING=true

# Optional Maven WAR project path for a separate application build/deploy workflow.
# Tomcat itself starts without this source directory.
FRONTWAS_HOST_PATH=../frontend
FRONTWAS_BIND_ADDRESS=127.0.0.1
FRONTWAS_PORT=18080
