# Application
APP_NAME=muilti-domain-rag

# Nginx
NGINX_VERSION=1.30.4-alpine3.24
NGINX_IMAGE=nginx:${NGINX_VERSION}
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8080
NGINX_CONTAINER_PORT=80
NGINX_DEV_CONFIG=./nginx/default.dev.conf
NGINX_DIST_PATH=../workspace-n3/earth-power-n3/dist

# Dev React / Vite
NODE_VERSION=24.20.0-bookworm
VITE_VERSION=latest
WEB_UI_SOURCE_PATH=../workspace-n3/earth-power-n3
WEB_UI_CONTAINER_PATH=/workspace/react-web-ui
VITE_DOCKERFILE=vite/Dockerfile.dev
VITE_BIND_ADDRESS=127.0.0.1
VITE_PORT=8183
VITE_CONTAINER_PORT=83

VITE_USE_POLLING=true

# Java application source / Tomcat WAS
FRONTEND_SOURCE_PATH=../workspace-n4/earth-power-n4
FRONTEND_CONTAINER_PATH=/workspace/frontend
TOMCAT_VERSION=10.1.59-jre21-temurin-noble
TOMCAT_DOCKERFILE=tomcat/Dockerfile.dev
TOMCAT_IMAGE=tomcat-frontend:${APP_NAME}
FRONTWAS_BIND_ADDRESS=127.0.0.1
FRONTWAS_PORT=8181
FRONTWAS_CONTAINER_PORT=81
FRONTEND_WAR_PATH=${FRONTEND_SOURCE_PATH}/target

#MAVEN 
MAVEN_VERSION=3.9.11
