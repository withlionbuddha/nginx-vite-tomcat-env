# Application
APP_NAME=muilti-domain-rag

# Nginx
NGINX_VERSION=1.30.4-alpine3.24
NGINX_IMAGE=nginx:${NGINX_VERSION}
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8080
NGINX_CONTAINER_PORT=80
NGINX_DEV_CONFIG=./nginx/default.dev.conf

# Dev React / Vite
NODE_VERSION=24.20.0-bookworm
VITE_VERSION=latest
WEB_UI_SOURCE_PATH=../react-web-ui
WEB_UI_CONTAINER_PATH=/workspace/react-web-ui
VITE_DOCKERFILE=vite/Dockerfile.dev
VITE_BIND_ADDRESS=127.0.0.1
VITE_PORT=8183
VITE_CONTAINER_PORT=8183

# Reference React / Vite
REFERENCE_UI_SOURCE_PATH=../ref-react-web-ui/bulletproof-react
REFERENCE_UI_CONTAINER_PATH=/workspace/reference-ui
REFERENCE_UI_WORKING_DIR=/workspace/reference-ui/apps/react-vite
REFERENCE_UI_BIND_ADDRESS=127.0.0.1
REFERENCE_UI_PORT=8184
REFERENCE_UI_CONTAINER_PORT=8184

VITE_USE_POLLING=true

# Java application source / Tomcat WAS
FRONTEND_SOURCE_PATH=../frontend
FRONTEND_CONTAINER_PATH=/workspace/frontend
TOMCAT_VERSION=10.1.59-jre21-temurin-noble
TOMCAT_DOCKERFILE=tomcat/Dockerfile
TOMCAT_IMAGE=tomcat-frontend:${APP_NAME}
FRONTWAS_BIND_ADDRESS=127.0.0.1
FRONTWAS_PORT=18080
FRONTWAS_CONTAINER_PORT=8080
