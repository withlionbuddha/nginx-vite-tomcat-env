###--------- Docker Compose environment variables -------------##

### Application
APP_NAME=muilti-domain-rags

### Volume Mount 
### Windows(SOURCE) PATH - Conatiner Path
SSL_SOURCE_DIR_PATH=/mnt/host/f/project.earth.power/nginx-vite-tomcat-env/.offline
SSL_TARGET_DIR_PATH=/etc/nginx/ssl

WEB_UI_SOURCE_PATH=/mnt/host/f/project.earth.power/workspace-n3/earth-power-n3
FRONTEND_SOURCE_PATH=/mnt/host/f/project.earth.power/workspace-n4/earth-power-n4
FRONTEND_SOURCE_WAR_PATH=${FRONTEND_SOURCE_PATH}/target/war

### Ports
### Windows(Host) Port - Container Port
NGINX_HOST_ADDRESS=127.0.0.1
NGINX_HOST_PORT=80
NGINX_HOST_SSL_PORT=443

VITE_HOST_ADDRESS=127.0.0.1
VITE_HOST_PORT=83

FRONTWAS_HOST_ADDRESS=127.0.0.1
FRONTWAS_HOST_PORT=8080

### configs

### Tomcat
TOMCAT_VERSION=10.1.59-jre21-temurin-noble
MAVEN_VERSION=3.9.11

### NODE
NODE_VERSION=24.20.0-bookworm

### VITE
VITE_USE_POLLING=true

### NGINX
NGINX_CONFIG=default.env.dev.conf
NGINX_VERSION=1.30.4-alpine3.24
NGINX_IMAGE=nginx:${NGINX_VERSION}

