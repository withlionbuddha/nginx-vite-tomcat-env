APP_NAME=muilti-domain-rag
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8080

# React source directory on the host (relative to this Compose directory).
WEB_UI_HOST_PATH=../web-ui
# Windows VS Code / PowerShell with Docker Desktop:
# WEB_UI_HOST_PATH=F:/project.asdf/web-ui
# A WSL distribution shell with Docker Desktop integration:
# WEB_UI_HOST_PATH=/mnt/f/project.asdf/web-ui
# Linux / cloud Docker host:
# WEB_UI_HOST_PATH=/srv/project.asdf/web-ui

# Enable file polling for edits to Windows files mounted into Linux containers.
VITE_USE_POLLING=true

# Maven WAR project; set this to the directory containing pom.xml.
FRONTWAS_HOST_PATH=../frontend
# Windows example: FRONTWAS_HOST_PATH=F:/project.asdf/frontend
# WSL example: FRONTWAS_HOST_PATH=/mnt/f/project.asdf/frontend
# Linux example: FRONTWAS_HOST_PATH=/srv/project.asdf/frontend
FRONTWAS_BIND_ADDRESS=127.0.0.1
FRONTWAS_PORT=18080
