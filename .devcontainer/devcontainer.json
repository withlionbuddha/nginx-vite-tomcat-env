{
  "name": "nginx-vite-tomcat-env",
  "dockerComposeFile": "../docker-compose.dev.yml",
  "service": "vite-devserver",
  "runServices": [
    "nginx-staticweb",
    "vite-devserver",
    "ref-vite-devserver",
    "tomcat-frontend"
  ],
  "workspaceFolder": "/workspace/web-ui",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8080, 8183, 8184, 18080],
  "portsAttributes": {
    "8080": {
      "label": "Nginx Web Server"
    },
    "8183": {
      "label": "Vite Development Server"
    },
    "8184": {
      "label": "Reference Vite Server"
    },
    "18080": {
      "label": "Tomcat Frontend"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml"
      ]
    }
  }
}
