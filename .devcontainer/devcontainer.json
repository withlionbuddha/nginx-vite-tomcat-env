{
  "name": "nginx-vite-tomcat-env",
  "dockerComposeFile": "../docker-compose.dev.yml",
  "service": "vite-devserver",
  "runServices": [
    "nginx-staticweb",
    "vite-devserver",
    "ref-vite-devserver",
    "tomcat-frontend"
  ],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml"
      ]
    }
  }
}
