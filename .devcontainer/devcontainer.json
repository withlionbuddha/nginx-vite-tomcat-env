{
  "name": "React workspace on vite-devserver",
  "dockerComposeFile": "../docker-compose.staticweb.dev.yml",
  "service": "vite-devserver",
  "runServices": ["vite-devserver", "nginx-staticweb"],
  "workspaceFolder": "/workspace/web-ui",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "forwardPorts": ["nginx-staticweb:80"],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml"
      ]
    }
  }
}
